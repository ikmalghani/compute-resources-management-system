# Copy to .env next to docker-compose.yml. Compose reads .env for substitution.
# Do not put an administrator password here. The first visit to the app creates that account.

# Required on any host you care about. Generate one with: openssl rand -hex 32
AUTH_SECRET=replace-this-with-a-long-random-string

# Optional. Defaults match docker-compose.yml.
# POSTGRES_USER=myspace
# POSTGRES_PASSWORD=myspace
# POSTGRES_DB=myspace

# Used when the app runs outside Compose (Postgres is on localhost, not db).
DATABASE_URL=postgresql://myspace:myspace@localhost:5432/myspace?schema=public

# Docker Hub image names. Leave unset to build locally.
# CREMS_APP_IMAGE=youruser/crems:latest
# CREMS_WORKSPACE_IMAGE=youruser/crems-workspace:latest
